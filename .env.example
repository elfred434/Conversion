# Template des clés API.
# Ce projet lit les clés via des --dart-define (voir README).
# Renseigne ci-dessous puis lance l'app avec les commandes documentées,
# OU exporte ces variables dans ton shell avant `flutter run`.

# Fournisseur LLM à utiliser : "openai" (defaut) ou "gemini"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=xxxxxxxx
